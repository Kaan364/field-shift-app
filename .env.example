# ---------------------------------------------------------------------------
# Project Alphecca - environment configuration
# Copy this file to ".env" and fill in the values you need.
# ---------------------------------------------------------------------------

APP_NAME="Project Alphecca API"
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma separated list or "*" for development
CORS_ORIGINS=*

# --- NASA POWER -------------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIMEOUT_SECONDS=30
NASA_POWER_CACHE_TTL_SECONDS=3600
NASA_POWER_DAILY_CACHE_TTL_SECONDS=1800
NASA_POWER_MAX_RETRIES=2
NASA_POWER_RETRY_BACKOFF_SECONDS=0.75

# --- AI provider ------------------------------------------------------------
# heuristic | gemini | openai | anthropic | groq | mistral | deepseek | xai
# | together | openrouter | ollama | custom
AI_PROVIDER=heuristic
AI_API_KEY=
# Gemini için güncel öneri: gemini-3.5-flash-lite (2.5 Aralık 2026'da yönlendiriliyor)
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1600

# Rule engine vs AI blend. 0.0 = only agronomic rules, 1.0 = only AI.
AI_WEIGHT=0.35

# Blend the AI narrative with the deterministic rule-engine narrative,
# risks and actions instead of replacing one with the other.
AI_BLEND_WITH_HEURISTIC=true

# If the LLM call fails, return the deterministic rule-based analysis instead
# of failing the whole request.
AI_FALLBACK_TO_HEURISTIC=true

# Do not send more than this many candidate crops to the LLM (token control).
MAX_AI_CANDIDATES=8

# --- Harita / yer adı (OpenStreetMap Nominatim, anahtar gerekmez) ------------
GEOCODING_ENABLED=true
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_SECONDS=8
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_USER_AGENT="ProjectAlphecca/0.1 (agricultural decision support)"
GEOCODING_LANGUAGE=en

# --- Arayüz -----------------------------------------------------------------
# Tarayıcı konum sayfasının (GET /geo) geri döneceği varsayılan adres.
# Göreli yol olabilir; varsayılan çiftçi PWA'sıdır.
UI_BASE_URL=/app/
